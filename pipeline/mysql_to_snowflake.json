{
	"name": "mysql_to_snowflake",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "MySqlSource"
					},
					"sink": {
						"type": "SnowflakeV2Sink",
						"importSettings": {
							"type": "SnowflakeImportCopyCommand"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_MySql_1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_Snowflake_1",
						"type": "DatasetReference",
						"parameters": {
							"tablename": "SALES_ORDERS_SNOWFLAKE"
						}
					}
				]
			}
		],
		"folder": {
			"name": "ksr_project"
		},
		"annotations": []
	}
}